# ============================================================
# DevOps Incident Support Model — Root Environment Variables
# Copy to .env and customise. Never commit .env to version control.
# ============================================================

# Environment: development | testing | production
APP_ENV=development

# Logging
LOG_LEVEL=DEBUG

# Server port (used by docker-compose)
PORT=8000

# -------------------------------------------------------
# Database (used by backend container + Alembic)
# -------------------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=devops_incident_db
DATABASE_USER=devops_user
DATABASE_PASSWORD=devops_password
DATABASE_URL=

# Pool configuration
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# -------------------------------------------------------
# PostgreSQL container (consumed by the postgres service)
# -------------------------------------------------------
POSTGRES_DB=devops_incident_db
POSTGRES_USER=devops_user
POSTGRES_PASSWORD=devops_password
