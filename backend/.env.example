# ============================================================
# DevOps Incident Support Model — Backend Environment Variables
# Copy to .env and customise. Never commit .env to version control.
# ============================================================

# -------------------------------------------------------
# Application
# -------------------------------------------------------
APP_NAME="DevOps Incident Support Model"
APP_VERSION="1.0.0"

# Environment: development | testing | production
APP_ENV=development

DEBUG=true

# -------------------------------------------------------
# API
# -------------------------------------------------------
API_V1_PREFIX=/api/v1

# -------------------------------------------------------
# Server
# -------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=1

# -------------------------------------------------------
# Logging
# -------------------------------------------------------
LOG_LEVEL=DEBUG
LOG_DIR=logs
LOG_FILE=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# -------------------------------------------------------
# Database — individual fields (used when DATABASE_URL is empty)
# -------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=devops_incident_db
DATABASE_USER=devops_user
DATABASE_PASSWORD=devops_password

# Optional: set this to override all DATABASE_* fields above.
# Must use postgresql:// or postgresql+asyncpg:// scheme.
DATABASE_URL=

# -------------------------------------------------------
# Database — connection pool
# -------------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false
DB_USE_NULL_POOL=false

# -------------------------------------------------------
# Security & JWT
# -------------------------------------------------------
# WARNING: Generate a strong secret in production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-A-LONG-RANDOM-STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# -------------------------------------------------------
# CORS & Trusted Hosts
# -------------------------------------------------------
# Comma-separated list; use "*" in development only
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
TRUSTED_HOSTS=*

# -------------------------------------------------------
# Rate limiting (SlowAPI)
# -------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_FORGOT_PASSWORD=3/minute
RATE_LIMIT_RESET_PASSWORD=5/minute
RATE_LIMIT_REFRESH=20/minute
